{
  "name": "@grupoitss/prizm-ui",
  "version": "0.1.0",
  "description": "Componentes React do PRIZM, estilizados com Tailwind e os design tokens de @grupoitss/prizm-tokens.",
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrupoITSS/PRIZM-Design-System.git",
    "directory": "design-system/packages/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./button": {
      "import": {
        "types": "./dist/button.d.mts",
        "default": "./dist/button.mjs"
      },
      "require": {
        "types": "./dist/button.d.cts",
        "default": "./dist/button.cjs"
      }
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint . --max-warnings 0",
    "clean": "rm -rf .turbo node_modules dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "react": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
