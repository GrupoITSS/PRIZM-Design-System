  "states": {
    "default": {
      "background": "color/input-background",
      "text": "color/foreground",
      "placeholder": "color/muted-foreground",
      "border": "color/input",
      "shadow": "shadow/xs"
    },
    "focus": {
      "border": "color/transparent",
      "ring": "color/ring",
      "ringWidth": 2,
      "ringOffsetWidth": 0,
      "note": "Vale também para a lista aberta (data-[state=open]), decisão P3 de 26/10/2026."
    },
    "error": {
      "border": "color/destructive",
      "attribute": "aria-invalid"
    },
    "errorFocus": {
      "border": "color/destructive",
      "ring": "color/ring",
      "ringWidth": 2
    },
    "disabled": {
      "background": "color/input-background",
      "border": "color/input",
      "shadow": "shadow/xs",
      "opacity": "opacity/50",
      "attribute": "disabled",
      "note": "Opacidade 50% na camada, sobre a aparência do default (26/10/2026)."
    }
  },
  "parts": {
    "chevron": {
      "icon": "ChevronDown",
      "size": "width/4",
      "color": "color/muted-foreground"
    },
    "content": {
      "background": "color/popover",
      "text": "color/popover-foreground",
      "border": "color/border",
      "radius": "radius/md",
      "padding": "spacing/1",
      "shadow": "shadow/md"
    },
    "item": {
      "text": "color/popover-foreground",
      "radius": "radius/sm",
      "paddingLeft": "spacing/2",
      "paddingRight": "spacing/8",
      "paddingY": "spacing/1-5",
      "fontSize": "text/sm",
      "highlighted": {
        "background": "color/accent",
        "text": "color/accent-foreground"
      },
      "check": {
        "icon": "Check",
        "size": "width/4"
      },
      "note": "O texto herda color/popover-foreground da lista (26/10/2026)."
    },
    "label": {
      "text": "color/muted-foreground",
      "fontSize": "text/xs",
      "fontWeight": "font-weight/medium",
      "paddingX": "spacing/2",
      "paddingY": "spacing/1-5"
    }
